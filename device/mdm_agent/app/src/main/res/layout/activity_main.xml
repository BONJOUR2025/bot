<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:typeface="monospace"
            android:paddingBottom="20dp" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://app.bonjour.pw"
            android:inputType="textUri"
            android:autofillHints="" />

        <EditText
            android:id="@+id/enrollKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ключ регистрации"
            android:inputType="textPassword"
            android:autofillHints="" />

        <Button
            android:id="@+id/enroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Зарегистрировать телефон" />

        <Button
            android:id="@+id/checkNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Связаться с сервером сейчас" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отключить экономию батареи" />

        <Button
            android:id="@+id/release"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Снять управление с телефона" />
    </LinearLayout>
</ScrollView>
