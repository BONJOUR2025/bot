# Loaded automatically by Vite for `npm run build` (mode=production),
# including deploy.ps1's plain build step — no env var needs to be set
# by hand at build time. See providers/ThemeProvider.jsx (adds/removes
# .visual-refresh on <html>) and styles/tokens.css / styles/globals.css
# (the rules actually gated behind that class).
VITE_VISUAL_REFRESH=1
